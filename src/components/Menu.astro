---
import { NAV, SITE } from '@/data/site'
---

<div class="menu" id="menu" aria-hidden="true">
  <div class="menu__inner wrap">
    <div class="menu__head">
      <span class="mono">Navigasi — 04</span>
      <span class="mono">{SITE.name}</span>
    </div>
    <p class="menu__note">Manusia biasa,<br /><em>bahagia dengan hal-hal kecil.</em></p>
    <nav class="menu__links" aria-label="Navigasi seluler">
      <a href="/" style="--i: 0"><span class="mono">00</span> Beranda</a>
      {NAV.map((item, index) => (
        <a href={item.href} style={`--i: ${index + 1}`}>
          <span class="mono">{String(index + 1).padStart(2, '0')}</span> {item.label}
        </a>
      ))}
    </nav>
    <div class="menu__foot">
      <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
      <div class="menu__socials">
        {SITE.socials.slice(0, 4).map((social) => (
          <a href={social.url} target="_blank" rel="noopener">{social.label}</a>
        ))}
      </div>
    </div>
  </div>
</div>
